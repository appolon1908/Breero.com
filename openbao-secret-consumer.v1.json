{
  "schemaVersion": 1,
  "repository": "appolon1908/Breero.com",
  "serviceIdentity": "breero-api",
  "namespacePrefix": "breero/api/runtime/",
  "delivery": "agent-rendered-file",
  "bindings": [
    {
      "setting": "DATABASE_URL",
      "fileEnvironment": "DATABASE_URL_FILE",
      "secretName": "database-url",
      "required": true
    },
    {
      "setting": "REDIS_URL",
      "fileEnvironment": "REDIS_URL_FILE",
      "secretName": "redis-url",
      "required": true
    },
    {
      "setting": "JWT_SECRET",
      "fileEnvironment": "JWT_SECRET_FILE",
      "secretName": "jwt-secret",
      "required": true
    },
    {
      "setting": "JWT_REFRESH_SECRET",
      "fileEnvironment": "JWT_REFRESH_SECRET_FILE",
      "secretName": "jwt-refresh-secret",
      "required": true
    },
    {
      "setting": "STRIPE_SECRET_KEY",
      "fileEnvironment": "STRIPE_SECRET_KEY_FILE",
      "secretName": "stripe-secret-key",
      "required": false
    },
    {
      "setting": "STRIPE_WEBHOOK_SECRET",
      "fileEnvironment": "STRIPE_WEBHOOK_SECRET_FILE",
      "secretName": "stripe-webhook-secret",
      "required": false
    },
    {
      "setting": "STRIPE_PUBLISHABLE_KEY",
      "fileEnvironment": "STRIPE_PUBLISHABLE_KEY_FILE",
      "secretName": "stripe-publishable-key",
      "required": false
    },
    {
      "setting": "GEOCODING_API_KEY",
      "fileEnvironment": "GEOCODING_API_KEY_FILE",
      "secretName": "geocoding-api-key",
      "required": false
    },
    {
      "setting": "PAYOUT_API_KEY",
      "fileEnvironment": "PAYOUT_API_KEY_FILE",
      "secretName": "payout-api-key",
      "required": false
    },
    {
      "setting": "SMTP_PASSWORD",
      "fileEnvironment": "SMTP_PASSWORD_FILE",
      "secretName": "smtp-password",
      "required": false
    },
    {
      "setting": "SMS_API_KEY",
      "fileEnvironment": "SMS_API_KEY_FILE",
      "secretName": "sms-api-key",
      "required": false
    },
    {
      "setting": "MIDDLEWARE_HMAC_SECRET",
      "fileEnvironment": "MIDDLEWARE_HMAC_SECRET_FILE",
      "secretName": "middleware-hmac-secret",
      "required": false
    },
    {
      "setting": "MIDDLEWARE_CLIENT_KEY",
      "fileEnvironment": "MIDDLEWARE_CLIENT_KEY_FILE",
      "secretName": "middleware-client-key",
      "required": false
    }
  ],
  "runtimeVerified": false,
  "secretValuesIncluded": false
}
